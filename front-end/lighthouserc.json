{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3211",
      "url": ["http://localhost:3211/", "http://localhost:3211/auth", "http://localhost:3211/termos"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
